# Free key from https://www.nps.gov/subjects/developer/get-started.htm
EXPO_PUBLIC_NPS_API_KEY=

# Chat API configuration
# URL of your deployed chat proxy server (e.g., https://chat.yourdomain.com)
EXPO_PUBLIC_CHAT_API_URL=
# App token to authenticate with the chat proxy (must match server's APP_TOKEN)
EXPO_PUBLIC_CHAT_APP_TOKEN=
