{
  "name": "featherglobe-chat-proxy",
  "version": "1.0.0",
  "description": "Chat proxy server for FeatherGlobe, forwards requests to Groq API",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop featherglobe-chat-proxy",
    "pm2:restart": "pm2 restart featherglobe-chat-proxy",
    "pm2:logs": "pm2 logs featherglobe-chat-proxy"
  },
  "keywords": [
    "groq",
    "chat",
    "proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "eslint": "^8.50.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  }
}
